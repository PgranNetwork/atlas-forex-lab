# Synthetic mode requires no secrets.
ATLAS_MT5_EURUSD_SYMBOL=EURUSD
ATLAS_MT5_XAUUSD_SYMBOL=XAUUSD
ATLAS_LOG_LEVEL=INFO
# Optional Telegram bot; install with: pip install -e '.[telegram]'
ATLAS_TELEGRAM_BOT_TOKEN=
ATLAS_FINGERPRINT_SECRET=replace-with-a-random-secret-at-least-16-characters
ATLAS_AFFILIATE_DB=atlas-affiliates.sqlite3
# Only use URLs supplied or approved by the relevant broker affiliate program.
ATLAS_BROKER_LINKS=
